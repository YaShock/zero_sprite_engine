// Nanobot, from AlgoGame: the player's ship, a sleek body of brushed steel with side
// paddles, a panel seam, a highlight streak and a glass visor (in ship units; the game adds
// tendrils in a helix behind it, a capsule list it updates every frame).
size 160 84
param unit = 2.4 in [1, 4]            // pixels per ship unit
param squash = 1 in [0.95, 1] animate 1 pingpong // the body squashes while thrusting

let sp = coord / unit + [7, 0]
let bp = sp / vec2(squash, 2 - squash)
let body = sd_polygon(bp, [[34, 0], [29.67, -1.33], [25.59, -2.98], [21.66, -4.8], [17.75, -6.62], [13.75, -8.31], [9.53, -9.7], [4.99, -10.65], [0, -11], [-4.22, -10.45], [-7.91, -9.56], [-11.07, -8.4], [-13.75, -7], [-15.96, -5.41], [-17.72, -3.69], [-19.06, -1.87], [-20, 0], [-19.06, 1.87], [-17.72, 3.69], [-15.96, 5.41], [-13.75, 7], [-11.07, 8.4], [-7.91, 9.56], [-4.22, 10.45], [0, 11], [4.99, 10.65], [9.53, 9.7], [13.75, 8.31], [17.75, 6.62], [21.66, 4.8], [25.59, 2.98], [29.67, 1.33]])
let fin_top = sd_segment(bp, [-5, -8], [-16, -11.5]) - 2.6
let fin_bottom = sd_segment(bp, [-5, 8], [-16, 11.5]) - 2.6
let hull = min(body, min(fin_top, fin_bottom))

// Steel: a gradient down the body through uneven stops
let st = (bp.y + 13) / 26
let steel = mix(mix(mix(mix(mix(#faf8f4, #e0dcd4, saturate(st / 0.2)), #b3aea5, saturate((st - 0.2) / 0.25)), #6e6961, saturate((st - 0.45) / 0.33)), #958f86, saturate((st - 0.78) / 0.14)), #6e6961, saturate((st - 0.92) / 0.08))
// Brushed grain: faint lines along the body, each row starting and ending unevenly
let row = floor(bp.y)
let along = step(-20 + hash(row + 4.711) * 8, bp.x) * step(bp.x, 34 - hash(row + 4.712) * 12)
let line = 1 - smoothstep(0.1, 0.25, abs(fract(bp.y - hash(row + 4.713) * 0.3) - 0.5))
// Panel seam, highlight streak and the glass visor
let seam = sd_polyline(bp, [[-3, -10.4], [-1.89, -6.93], [-1.22, -3.47], [-1, 0], [-1.22, 3.47], [-1.89, 6.93], [-3, 10.4]]) - 0.3
let streak = sd_polyline(bp, [[26, -2.6], [23, -3.85], [19.97, -5.04], [16.89, -6.13], [13.75, -7.1], [10.51, -7.92], [7.16, -8.56], [3.66, -9], [0, -9.2]]) - 0.45
let visor_local = rotate(bp - [10, -3.2], 0.12)
let visor = (length(visor_local / [8, 2.4]) - 1) * 2.4
let gt = (bp.y + 5.6) / 4.8
let glass = mix(mix(#faf8f4, #e6ecef, saturate(gt / 0.5)), #b3aea5, saturate((gt - 0.5) / 0.5))

let inner = stack(
    steel,
    mask(#ffffff12, along * line),
    mask(#77726a, fill(seam * unit)),
    mask(#faf8f4, fill(streak * unit)),
    mask(glass, fill(visor * unit)))
stack(mask(#2e2b27, fill((hull - 0.7) * unit)), mask(inner, fill(hull * unit)))
