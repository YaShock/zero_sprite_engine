package main

// Named colors, all compile-time constants. fx.Expr accepts rl.Color directly.

import rl "vendor:raylib"

// Players: index 0 is neutral, 1 the human, the rest bots.
NEUTRAL_GRAY :: rl.Color{0x9a, 0x9a, 0xa4, 0xff}
PLAYER_BLUE :: rl.Color{0x4c, 0xa8, 0xff, 0xff}
BOT_RED :: rl.Color{0xff, 0x52, 0x48, 0xff}
BOT_GREEN :: rl.Color{0x6c, 0xe8, 0x5a, 0xff}
BOT_PURPLE :: rl.Color{0xc8, 0x6c, 0xff, 0xff}

// Space
SPACE_BLACK :: rl.Color{0x02, 0x03, 0x08, 0xff}
STAR_WHITE :: rl.Color{0xf4, 0xf6, 0xff, 0xff}
STAR_BLUE :: rl.Color{0xa8, 0xc8, 0xff, 0xff}
STAR_GOLD :: rl.Color{0xff, 0xe0, 0xa8, 0xff}
SUN_CORE :: rl.Color{0xff, 0xf8, 0xe0, 0xff}
SUN_GLOW :: rl.Color{0xff, 0xb8, 0x60, 0xff}
SPACE_AMBIENT :: rl.Color{0x8c, 0xa0, 0xd8, 0xff}
ASTEROID_ROCK :: rl.Color{0x6e, 0x64, 0x5a, 0xff}
ASTEROID_DARK :: rl.Color{0x32, 0x2c, 0x28, 0xff}
DEBRIS_METAL :: rl.Color{0x8a, 0x92, 0x9c, 0xff}
COMET_ICE :: rl.Color{0xc8, 0xf0, 0xff, 0xff}
ENGINE_HOT :: rl.Color{0xff, 0xf0, 0xc8, 0xff}
WHITE :: rl.Color{0xff, 0xff, 0xff, 0xff}
BLACK :: rl.Color{0x00, 0x00, 0x00, 0xff}

// Fixed planet colors (the rest are randomized from the ranges below)
ICE_WHITE :: rl.Color{0xee, 0xf6, 0xff, 0xff}
ICE_BLUE :: rl.Color{0x8c, 0xbc, 0xe8, 0xff}
LAVA_ROCK :: rl.Color{0x2a, 0x1c, 0x18, 0xff}
LAVA_DARK :: rl.Color{0x10, 0x0a, 0x08, 0xff}
LAVA_RED :: rl.Color{0xd8, 0x30, 0x0c, 0xff}
LAVA_YELLOW :: rl.Color{0xff, 0xd8, 0x60, 0xff}
CLOUD_WHITE :: rl.Color{0xf8, 0xfa, 0xff, 0xff}
CITY_LIGHT :: rl.Color{0xff, 0xd8, 0x90, 0xff}
CRATER_DARK :: rl.Color{0x2c, 0x2a, 0x28, 0xff}

// UI
SELECT_BOX :: rl.Color{0xb8, 0xdc, 0xff, 0xff}
BAR_BACK :: rl.Color{0x14, 0x18, 0x24, 0xff}
TEXT_LIGHT :: rl.Color{0xe8, 0xee, 0xff, 0xff}
TEXT_DIM :: rl.Color{0x8c, 0x96, 0xb0, 0xff}
TEXT_GOLD :: rl.Color{0xff, 0xd4, 0x60, 0xff}

// Randomization ranges (HSV: hue in degrees, saturation and value in 0..1).
NEBULA_HUE :: [2]f32{0, 360}
OCEAN_HUE :: [2]f32{185, 230}
LAND_HUE :: [2]f32{30, 130}
DESERT_HUE :: [2]f32{18, 42}
TOXIC_HUE :: [2]f32{60, 110}
GAS_HUE :: [2]f32{0, 360}
BARREN_HUE :: [2]f32{20, 60}
