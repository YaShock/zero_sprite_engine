package main

// Named colors, all compile-time constants. fx.Expr accepts rl.Color directly.

import rl "vendor:raylib"

// Terrain tones are randomized per run between these bounds (HSV: hue in degrees,
// saturation and value in 0..1).
GRASS_HUE :: [2]f32{72, 130}
GRASS_SATURATION :: [2]f32{0.35, 0.6}
GRASS_VALUE :: [2]f32{0.4, 0.55}
DRY_HUE_SHIFT :: [2]f32{20, 38} // dry patches lean towards yellow
DIRT_HUE :: [2]f32{20, 36}
DIRT_SATURATION :: [2]f32{0.3, 0.5}
DIRT_VALUE :: [2]f32{0.36, 0.48}
STONE_HUE :: [2]f32{20, 220}
STONE_SATURATION :: [2]f32{0.03, 0.12}
STONE_VALUE :: [2]f32{0.55, 0.68}

// Shared
OUTLINE :: rl.Color{0x14, 0x10, 0x0e, 0xff}
SHADOW :: rl.Color{0x00, 0x00, 0x00, 0xff}
WHITE :: rl.Color{0xff, 0xff, 0xff, 0xff}
FLOWER_WHITE :: rl.Color{0xf4, 0xf0, 0xe0, 0xff}
GRID_LINE :: rl.Color{0xf0, 0xf0, 0xd8, 0xff}
VALID_GREEN :: rl.Color{0x6c, 0xf0, 0x7a, 0xff}
INVALID_RED :: rl.Color{0xff, 0x4a, 0x3c, 0xff}
RANGE_WHITE :: rl.Color{0xf8, 0xf4, 0xe8, 0xff}

// Structures
